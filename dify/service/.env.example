# 「迷宮酒館」session-state service — environment template.
# Copy to `.env` and fill in real values. Never commit the filled-in file.

# --- HTTP ------------------------------------------------------------------
PORT=8787
# Bind to 0.0.0.0 when Dify runs in Docker: the containers reach the service
# through `host.docker.internal`, which cannot reach a 127.0.0.1-only listener.
HOST=0.0.0.0

# --- seekdb / OceanBase ----------------------------------------------------
# `server` mode talks to an existing seekdb or OceanBase instance over the
# MySQL protocol; `embedded` keeps a local database directory (needs the
# native seekdb binding, which is blocked on some Windows machines).
SEEKDB_MODE=server
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=difyai123456
SEEKDB_TENANT=
SEEKDB_DATABASE=test
STATE_COLLECTION=maze_tavern_state
MEMORY_COLLECTION=maze_tavern_memory

# --- embeddings ------------------------------------------------------------
# The memory log is embedded so seekdb can serve *semantic* recall of earlier
# turns. Any OpenAI-compatible /v1/embeddings endpoint works.
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=2048
EMBEDDING_BATCH=16

# --- misc ------------------------------------------------------------------
# How many memory entries a search returns by default.
MEMORY_TOP_K=5
