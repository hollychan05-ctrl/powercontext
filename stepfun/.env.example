# Copy to .env and adjust. Values here are placeholders — never commit real credentials.

# Backend listening port (the browser app is served from the same origin).
PORT=8787

# seekdb connection.
# embedded: this process owns a local database directory (Windows/Linux/macOS supported).
# server:   connect to an existing seekdb / OceanBase instance.
SEEKDB_MODE=embedded
SEEKDB_PATH=./.seekdb/kb.db

# Only used when SEEKDB_MODE=server:
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2882
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_TENANT=
SEEKDB_DATABASE=test

# Collection and embedding dimension. The dimension must match the browser model
# (all-MiniLM-L6-v2 and bge-small-en-v1.5 are both 384).
SEEKDB_COLLECTION=kb_documents
EMBEDDING_DIMENSION=384
